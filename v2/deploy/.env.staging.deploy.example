# Skopírovať ako deploy/.env.staging.deploy a nahradiť všetky ukážkové hodnoty.
CARLO_BACKEND_IMAGE=ghcr.io/3horky/domcek-bot/backend@sha256:replace
CARLO_FRONTEND_IMAGE=ghcr.io/3horky/domcek-bot/frontend@sha256:replace
CARLO_POSTGRES_IMAGE=postgres:18.4-alpine@sha256:replace
CARLO_CADDY_IMAGE=caddy:2-alpine@sha256:replace
CARLO_PUBLIC_HOST=carlo-staging.example.sk
CARLO_ENV_FILE=.env.staging
CARLO_SECRETS_DIR=/srv/carlo-staging/secrets
CARLO_THOUGHTS_FILE=/srv/carlo-staging/thoughts.txt
