PUBLICATION_REMINDER_LEAD_HOURS=24
# `shadow` skladá dôkazy bez Discord odoslania; `live` sa zapína až pri E13 cutoveri.
PUBLICATION_EXECUTION_MODE=shadow
# Výnimočne iba pre izolovaný HTTPS staging UAT; local/production túto voľbu odmietne.
ALLOW_MANUAL_PUBLICATION_IN_SHADOW=false
PUBLICATION_RECOVERY_STALE_SECONDS=90
PUBLICATION_RETRY_ATTEMPTS=3
PUBLICATION_SEEN_EMOJI=✅
DISCORD_SYNC_GUILD_COMMANDS=true
DISCORD_DM_RESPONSE_ENABLED=true
BOT_THOUGHTS_FILE=/run/project-assets/thoughts.txt
