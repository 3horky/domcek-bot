# Skopírovať ako .env.staging iba na staging hoste. Neobsahuje žiadne tajomstvá.
APP_ENV=staging
APP_VERSION=replace-with-release-id
LOG_LEVEL=INFO
LOG_FORMAT=json
TIMEZONE=Europe/Bratislava

POSTGRES_DB=carlo_staging
POSTGRES_USER=carlo_staging
POSTGRES_PASSWORD=replace-with-long-random-staging-password
DATABASE_URL=postgresql+asyncpg://carlo_staging:replace-with-long-random-staging-password@db:5432/carlo_staging
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5

API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=https://carlo-staging.example.sk
FRONTEND_BASE_URL=https://carlo-staging.example.sk
MEDIA_ROOT=/var/lib/domcek/media
PUBLIC_MEDIA_BASE_URL=https://carlo-staging.example.sk
MEDIA_MAX_UPLOAD_BYTES=8388608
MEDIA_MAX_IMAGE_EDGE=1600
SESSION_SECRET_FILE=/run/project-secrets/session-secret
SESSION_LIFETIME_HOURS=12
OAUTH_STATE_LIFETIME_MINUTES=10

# Výhradne testovacia Discord aplikácia, guild, role, kanály a kategórie.
DISCORD_APPLICATION_ID=replace
DISCORD_GUILD_ID=replace
DISCORD_ADMIN_ROLE_ID=replace
DISCORD_TEAM_MOD_ROLE_ID=replace
DISCORD_PUBLISHER_ROLE_ID=replace
DISCORD_COMMAND_CHANNEL_ID=replace
DISCORD_ANNOUNCEMENT_CHANNEL_ID=replace
DISCORD_MODERATOR_CHANNEL_ID=replace
DISCORD_PROJECTS_CATEGORY_ID=replace
DISCORD_ARCHIVE_CATEGORY_ID=replace
DISCORD_BOT_TOKEN_FILE=/run/project-secrets/bot-token
DISCORD_OAUTH_CLIENT_ID=replace
DISCORD_OAUTH_CLIENT_SECRET_FILE=/run/project-secrets/oauth-client-secret
DISCORD_OAUTH_REDIRECT_URI=https://carlo-staging.example.sk/api/v1/auth/discord/callback
DISCORD_SYNC_GUILD_COMMANDS=false
DISCORD_DM_RESPONSE_ENABLED=true

# Service account musí mať iba calendar.readonly nad testovacími kalendármi.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/project-secrets/google-service-account.json
CALENDAR_SYNC_PAST_DAYS=30
CALENDAR_SYNC_FUTURE_DAYS=400
CALENDAR_SYNC_PAGE_SIZE=250
CALENDAR_REQUEST_TIMEOUT_SECONDS=15
CALENDAR_RETRY_ATTEMPTS=3
CALENDAR_RETRY_BASE_SECONDS=0.5
CALENDAR_STALE_WARNING_MINUTES=120
CALENDAR_MAX_SAFE_AGE_MINUTES=360

WORKER_POLL_INTERVAL_SECONDS=30
CALENDAR_SYNC_INTERVAL_SECONDS=300
PUBLICATION_GRACE_PERIOD_MINUTES=120
PUBLICATION_REMINDER_LEAD_HOURS=24
# E12 staging musí zostať shadow. Ručnú výnimku povoľuje iba riadený UAT krok.
PUBLICATION_EXECUTION_MODE=shadow
ALLOW_MANUAL_PUBLICATION_IN_SHADOW=false
PUBLICATION_RECOVERY_STALE_SECONDS=90
PUBLICATION_RETRY_ATTEMPTS=3
PUBLICATION_SEEN_EMOJI=✅
BOT_THOUGHTS_FILE=/run/project-assets/thoughts.txt
INTRO_GENERATOR_MODEL=gemini-2.5-flash-lite
INTRO_GENERATOR_TIMEOUT_SECONDS=12
